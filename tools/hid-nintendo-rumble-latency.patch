--- a/drivers/hid/hid-nintendo.c
+++ b/drivers/hid/hid-nintendo.c
@@ -1818,8 +1818,11 @@ static int joycon_send_rumble_data(struct joycon_ctlr *ctlr)
 	if (++ctlr->subcmd_num > 0xF)
 		ctlr->subcmd_num = 0;
 
-	joycon_enforce_subcmd_rate(ctlr);
+	/* Diagnostic: input-report batching can make the 8..17 ms cadence test
+	 * fail repeatedly, delaying an otherwise asynchronous rumble request by
+	 * hundreds of milliseconds.  Rumble-only output has no response to wait
+	 * for, so bypass the subcommand scheduler for this test. */
 
 	ret = __joycon_hid_send(ctlr->hdev, (u8 *)&rumble_output,
 				sizeof(rumble_output));
